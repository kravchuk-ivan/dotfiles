# Shared zsh config. ~/.zshrc sources this file and stays machine-local:
# installers append their PATH lines there, and secrets (API keys) belong
# there too, below the source line, never in this public repo.

# Powerlevel10k instant prompt. Keep it first: anything that prints or reads
# input has to come before it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Homebrew's script installer doesn't add itself to PATH (its .pkg installer
# writes /etc/paths.d/homebrew instead).
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_NO_ANALYTICS=1

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # the prompt comes from powerlevel10k below
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

source "$HOME/dotfiles/bash_aliases"

source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
# To customize the prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Claude Code's native installer puts `claude` here.
export PATH="$HOME/.local/bin:$PATH"
