# Shared zsh config. ~/.zshrc stays machine-local: installers append their
# PATH lines there, and secrets (API keys) belong there too, never in this
# public repo. zsh/setup.sh keeps a block at its top that sources this file
# between the powerlevel10k instant prompt and ~/.p10k.zsh.

# Homebrew's script installer doesn't add itself to PATH (its .pkg installer
# writes /etc/paths.d/homebrew instead).
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_NO_ANALYTICS=1

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # the prompt comes from powerlevel10k below
plugins=(git)
source "$ZSH/oh-my-zsh.sh"

source "$HOME/dotfiles/bash_aliases"

# Configured by ~/.p10k.zsh: run `p10k configure` or edit zsh/p10k.zsh.
source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Claude Code's native installer puts `claude` here.
export PATH="$HOME/.local/bin:$PATH"
